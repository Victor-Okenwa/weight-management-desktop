{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",

	"files": {
		"ignore": ["**/dist", "**/node_modules", "**/.turbo", "**/coverage"]
	},

	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},

	"json": {
		"formatter": {
			"enabled": true
		}
	},

	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,

			"style": {
				"useConst": "error",
				"useTemplate": "warn"
			},

			"suspicious": {
				"noExplicitAny": "warn"
			},

			"correctness": {
				"noUnusedVariables": "warn"
			}
		}
	},

	"organizeImports": {
		"enabled": true
	}
}
