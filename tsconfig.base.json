{
	"compilerOptions": {
		"target": "ES2022",

		"strict": true,

		"skipLibCheck": true,

		"resolveJsonModule": true,

		"allowSyntheticDefaultImports": true,

		"esModuleInterop": true,

		"isolatedModules": true
	},
	"include": ["packages/*/src/**/*", "apps/*/src/**/*"],
	"exclude": ["node_modules", "dist", ".cache", "build", ".next", ".expo"]
}
